# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a GitHub ni pegues estas claves en un chat.

# URL pública del sitio (sin / al final). Producción: https://cursos.enmodovideo.com · En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (proyecto NUEVO de cursos → Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tu correo: será el primer administrador (debe estar confirmado; con Google lo está)
ADMIN_EMAIL=

# PayPal Business (developer.paypal.com → Apps & Credentials). sandbox para pruebas, live para cobrar de verdad.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Webhooks de la app (eventos: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.REFUNDED, PAYMENT.CAPTURE.REVERSED)
PAYPAL_WEBHOOK_ID=

# Bunny Stream — la biblioteca de los CURSOS (la del CDN vz-e1730be6-c02.b-cdn.net), no la de tutos
BUNNY_LIBRARY_ID=
# Stream → tu biblioteca → Security → "Embed view token authentication key"
BUNNY_TOKEN_AUTH_KEY=
# Opcionales
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=vz-e1730be6-c02.b-cdn.net

# Resend (correos de compra, accesos y aviso a los migrados)
RESEND_API_KEY=
EMAIL_FROM=En Modo Video <hola@enmodovideo.com>
